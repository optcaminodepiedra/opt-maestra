model PrintJob {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation("BusinessPrintJobs", fields: [businessId], references: [id], onDelete: Cascade)

  printerId  String?
  printer    Printer?       @relation(fields: [printerId], references: [id])

  type       PrintJobType
  status     PrintJobStatus @default(PENDING)

  orderId    String?  // RestaurantOrder.id si aplica
  saleId     String?  // Sale.id si aplica

  payload    Json     // contenido a imprimir (estructurado)
  rawBytes   String?  // ESC/POS bytes en base64 (cache opcional)

