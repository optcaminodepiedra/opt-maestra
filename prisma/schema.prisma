generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER_ADMIN
  OWNER
  SUPERIOR
  MANAGER
  MANAGER_OPS
  ACCOUNTING
  SALES
  RESERVATIONS
  INVENTORY
  STAFF_MAINTENANCE
  MANAGER_RESTAURANT
  STAFF_CASHIER
  STAFF_WAITER
  STAFF_BAR
  STAFF_KITCHEN
  MANAGER_HOTEL
  STAFF_RECEPTION
  STAFF_HOUSEKEEPING
  MANAGER_RANCH
  STAFF_EXPERIENCES
  STAFF_FIELD
  STAFF_STORE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum WithdrawalKind {
  PETTY_CASH
  LARGE_REQUEST
}

enum MenuStation {
  KITCHEN
  BAR
  NONE
}

enum PrinterRole {
  KITCHEN
  BAR
  CASHIER
  OTHER
}

enum PrintJobStatus {
  PENDING
  PRINTING
  PRINTED
  FAILED
  CANCELED
}

enum PrintJobType {
  KITCHEN_TICKET
  BAR_TICKET
  CUSTOMER_RECEIPT
  OTHER
}

enum ModifierSelectionMode {
  SINGLE
  MULTIPLE
}

model Business {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

    ticketHeader     String?
  ticketFooter     String?
  ticketPhone      String?
  ticketAddress    String?
  ticketWebsite    String?
  ticketTagline    String?
  printAgentToken  String? @unique

  cashpoints  Cashpoint[]
  sales       Sale[]
  expenses    Expense[]
  shifts      Shift[]
  withdrawals Withdrawal[]

  users        User[] @relation("UserBusiness")
  primaryUsers User[] @relation("PrimaryBusiness")

  vacationRequests VacationRequest[]

  tasks Task[]

  restaurantTables RestaurantTable[] @relation("BusinessRestaurantTables")
  menuItems        MenuItem[]        @relation("BusinessMenuItems")
  restaurantOrders RestaurantOrder[] @relation("BusinessRestaurantOrders")
  restaurantAreas RestaurantArea[] @relation("BusinessRestaurantAreas")
    modifierGroups MenuModifierGroup[] @relation("BusinessModifierGroups")

  inventoryItems InventoryItem[]
inventoryMovesOrigin       InventoryMovement[] @relation("InventoryMovementOrigin")
inventoryMovesDestination  InventoryMovement[] @relation("InventoryMovementDestination")
  requisitions   Requisition[]

  eventsOwned     Event[] @relation("EventBusiness")
  eventsHosted    Event[] @relation("EventLocationBusiness")

  hotelRoomTypes    HotelRoomType[]
  hotelRooms        HotelRoom[]
  hotelReservations HotelReservation[]
  hotelCharges      HotelCharge[]
  hotelFolios       HotelFolio[]
  hotelPayments     HotelPayment[]
  accountsPayables  AccountsPayable[]

    saleLines              SaleLine[]
  salePayments           SalePayment[]
  softRestaurantShifts   SoftRestaurantShift[]
  externalUserMappings   ExternalUserMapping[]

  scheduledShifts ScheduledShift[] @relation("BusinessScheduledShifts")

  userAccess UserBusinessAccess[]

  printers   Printer[]   @relation("BusinessPrinters")
  printJobs  PrintJob[]  @relation("BusinessPrintJobs")

  // Hotel al que este negocio sirve alimentos (Bodega 4 -> Camino de Piedra)
  linkedHotelBusinessId String?
  linkedHotel           Business?  @relation("BusinessLinkedHotel", fields: [linkedHotelBusinessId], references: [id])
  linkedByRestaurants   Business[] @relation("BusinessLinkedHotel")

  importBatches ImportBatch[]

  integrationConnectors IntegrationConnector[]

  @@index([linkedHotelBusinessId])
}

model Cashpoint {
  id         String   @id @default(cuid())
  name       String
  businessId String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  shifts   Shift[]
  sales    Sale[]

  menuItems MenuItem[]

  restaurantTables RestaurantTable[] @relation("CashpointRestaurantTables")

  withdrawals Withdrawal[]

  @@unique([businessId, name])
}

model User {
  id           String   @id @default(cuid())
  fullName     String   @unique
  username     String   @unique
  email        String?  @unique
  passwordHash String
  role         Role
  requiresClockIn Boolean @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // RRHH
  jobTitle   String?
  department String?
  hireDate   DateTime? @db.Date

  pinHash      String?
  pinUpdatedAt DateTime?

  businessId String?
  business   Business? @relation("UserBusiness", fields: [businessId], references: [id])

  primaryBusinessId String?
  primaryBusiness   Business? @relation("PrimaryBusiness", fields: [primaryBusinessId], references: [id])

  externalUserMappings ExternalUserMapping[]
  sales                Sale[]
  expenses             Expense[]
  shifts               Shift[]
  withdrawalsRequested Withdrawal[] @relation("RequestedBy")
  withdrawalsApproved  Withdrawal[] @relation("ApprovedBy")

  assignedTasks Task[] @relation("AssignedTasks")
  createdTasks  Task[] @relation("CreatedTasks")

  taskComments    TaskComment[]
  taskAttachments TaskAttachment[]

  restaurantOrders RestaurantOrder[] @relation("UserRestaurantOrders")

  inventoryMovesCreated InventoryMovement[] @relation("InventoryMoveCreatedBy")
  reqCreated            Requisition[]       @relation("ReqCreatedBy")
  reqApproved           Requisition[]       @relation("ReqApprovedBy")

  eventsCreated             Event[]            @relation("EventCreatedBy")
  eventsResponsible         Event[]            @relation("EventResponsible")
  eventRequirementsAssigned EventRequirement[] @relation("EventRequirementResponsible")

  hotelReservations HotelReservation[] @relation("UserHotelReservations")
  hotelFolios       HotelFolio[]
  hotelPayments     HotelPayment[]

  workDays WorkDay[]

  vacationRequests        VacationRequest[] @relation("UserVacationRequests")
  vacationRequestsDecided VacationRequest[] @relation("VacationRequestDecidedBy")
  vacationBalances        VacationBalance[]

  scheduledShifts        ScheduledShift[] @relation("UserScheduledShifts")
  scheduledShiftsCreated ScheduledShift[] @relation("ScheduledShiftCreatedBy")

  businessAccess UserBusinessAccess[]

  requisitionsDelivered  Requisition[]    @relation("RequisitionDeliveredBy")
  requisitionsReceived   Requisition[]    @relation("RequisitionReceivedBy")
  accountsPayableCreated AccountsPayable[] @relation("AccountsPayableCreatedBy")
  accountsPayablePaid    AccountsPayable[] @relation("AccountsPayablePaidBy")
  notifications          Notification[]

  importBatchId         String?
  importBatch           ImportBatch?  @relation("UserImportBatch", fields: [importBatchId], references: [id])
  importBatchesCreated  ImportBatch[] @relation("ImportBatchCreatedBy")
  importBatchesReverted ImportBatch[] @relation("ImportBatchRevertedBy")

  cancellations OrderItemCancellation[] @relation("UserCancellations")

  integrationConnectorsCreated IntegrationConnector[] @relation("IntegrationConnectorCreatedBy")
}

model UserBusinessAccess {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

model Shift {
  id          String    @id @default(cuid())
  businessId  String
  cashpointId String
  openedById  String
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  notes       String?

  expectedCashCents     Int @default(0)
  expectedCardCents     Int @default(0)
  expectedTransferCents Int @default(0)

  countedCashCents     Int?
  countedCardCents     Int?
  countedTransferCents Int?

  business  Business  @relation(fields: [businessId], references: [id])
  cashpoint Cashpoint @relation(fields: [cashpointId], references: [id])
  openedBy  User      @relation(fields: [openedById], references: [id])

  sales Sale[]

  @@index([businessId, openedAt])
}

model Sale {
  id          String        @id @default(cuid())
  businessId  String
  cashpointId String
  shiftId     String?
  userId      String
  amountCents Int
  method      PaymentMethod
  concept     String
  createdAt   DateTime      @default(now())

    mesaName         String?
  noPersonas       Int?
  externalWaiterId String?
  externalShiftId  String?
  openedAt         DateTime?
  closedAt         DateTime?
  totalItems       Float?
  subtotalCents    Int?
  discountCents    Int?
  tipCents         Int?
  isCanceled       Boolean   @default(false)
  canceledAt       DateTime?
  canceledReason   String?
  ticketRef        String?
  serviceType      String?


  business  Business  @relation(fields: [businessId], references: [id])
  cashpoint Cashpoint @relation(fields: [cashpointId], references: [id])
  shift     Shift?    @relation(fields: [shiftId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

    lines    SaleLine[]
  payments SalePayment[]

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

    externalSource String?   // "softrestaurant", "manual", etc.
  externalFolio  String?   // Folio único del sistema origen

  @@index([businessId, createdAt])
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  userId      String
  amountCents Int
  category    String
  note        String?
  evidenceUrl String?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  externalSource String?
  externalFolio  String?

  accountsPayables AccountsPayable[] @relation("APExpense")

  @@index([businessId, createdAt])
}

model Withdrawal {
  id          String           @id @default(cuid())
  businessId  String
  amountCents Int
  reason      String?
  status      WithdrawalStatus @default(REQUESTED)

  cashpointId String?
  cashpoint   Cashpoint? @relation(fields: [cashpointId], references: [id])

  kind WithdrawalKind @default(PETTY_CASH)

  requestedById String
  approvedById  String?

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  business    Business @relation(fields: [businessId], references: [id])
  requestedBy User     @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?    @relation("ApprovedBy", fields: [approvedById], references: [id])

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  accountsPayables AccountsPayable[] @relation("APWithdrawal")

  @@index([businessId, createdAt])
  @@index([cashpointId, createdAt])
  @@index([kind, status])
}

enum TaskType {
  ACTIVITY
  TICKET
}

enum TaskStatus {
  TODO
  DOING
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Area {
  OPERATIONS
  SYSTEMS
  MARKETING
  ADMIN
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?

  type     TaskType
  status   TaskStatus
  priority Priority
  area     Area

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])

  assignedId String?
  assigned   User?   @relation("AssignedTasks", fields: [assignedId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])

  startDate  DateTime?
  dueDate    DateTime?
  endDate    DateTime?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([type, status])
  @@index([businessId])
  @@index([assignedId])
  @@index([createdById])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  name      String
  url       String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId, createdAt])
}

enum OrderStatus {
  OPEN
  SENT
  SERVED
  PAID
  CANCELED
}

enum KitchenStatus {
  NEW
  PREPARING
  READY
  DELIVERED
  CANCELED
}

enum TableShape {
  SQUARE
  ROUND
  RECTANGLE
  BAR
}

model RestaurantTable {
  id         String  @id @default(cuid())
  businessId String
  name       String
  capacity   Int     @default(4)
  isActive   Boolean @default(true)

  cashpointId String?
  cashpoint   Cashpoint? @relation("CashpointRestaurantTables", fields: [cashpointId], references: [id])

  area      String?
  posX      Int?
  posY      Int?
  sortOrder Int     @default(0)

  // ── NUEVO: forma y dimensiones para el editor visual ──
  shape    TableShape @default(SQUARE)
  width    Int        @default(80)   // en pixels (canvas)
  height   Int        @default(80)
  rotation Int        @default(0)    // 0, 90, 180, 270

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business          @relation("BusinessRestaurantTables", fields: [businessId], references: [id])
  orders   RestaurantOrder[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@index([businessId, area])
  @@index([cashpointId])
}

model MenuItem {
  id         String @id @default(cuid())
  businessId String

  cashpointId String?
  cashpoint   Cashpoint? @relation(fields: [cashpointId], references: [id])
    imageUrl    String?
  description String?
  isFeatured  Boolean @default(false)

    groupCode  String?
  groupName  String?
  isPhantom  Boolean @default(false)

  name       String
  category   String
  priceCents Int
  isActive   Boolean  @default(true)

  // ── NUEVO ──
  station    MenuStation @default(KITCHEN)
  printGroup String?      // ej: "Parrilla", "Fríos", "Barra principal"
  sortOrder  Int         @default(0)

  externalCode String?   // Ej: "01240" (clave SoftRestaurant)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business              @relation("BusinessMenuItems", fields: [businessId], references: [id])
  orderItems RestaurantOrderItem[]
  
    modifierGroups MenuItemModifierGroup[]

  @@index([businessId, isActive])
  @@index([businessId, category])
  @@index([businessId, station])
  @@index([cashpointId])
    saleLines  SaleLine[]
}

model RestaurantOrder {
  id         String      @id @default(cuid())
  businessId String
  tableId    String
  userId     String
  status     OrderStatus @default(OPEN)
  note       String?

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  business Business        @relation("BusinessRestaurantOrders", fields: [businessId], references: [id])
  table    RestaurantTable @relation(fields: [tableId], references: [id])
  user     User            @relation("UserRestaurantOrders", fields: [userId], references: [id])

  items RestaurantOrderItem[]

  @@index([businessId, status, openedAt])
  @@index([tableId, status])
}

model RestaurantOrderItem {
  id            String        @id @default(cuid())
  orderId       String
  menuItemId    String
  qty           Int           @default(1)
  priceCents    Int
  note          String?
  kitchenStatus KitchenStatus @default(NEW)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  modifiers Json?    // [{ name, priceCents, groupId }, ...]
  order    RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem        @relation(fields: [menuItemId], references: [id])

  @@index([orderId, createdAt])
  @@index([kitchenStatus, createdAt])
}

enum StockUnit {
  PIECE
  KG
  LT
  BOX
  PACK
}

enum MovementType {
  IN
  OUT
  ADJUST
  TRANSFER
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  RECEIVED_PARTIAL
  RECEIVED
  CLOSED
  CANCELED
}

enum EventStatus {
  DRAFT
  TENTATIVE
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum EventRequirementStatus {
  PENDING
  IN_PROGRESS
  READY
  NOT_REQUIRED
  CANCELED
}

enum EventPaymentTiming {
  NOT_DEFINED
  BEFORE_EVENT
  AT_EVENT
  AFTER_EVENT
  PARTIAL
  NO_CHARGE
}

enum EventPaymentStatus {
  PENDING
  PARTIAL
  PAID
  NOT_REQUIRED
}

model InventoryItem {
  id         String    @id @default(cuid())
  businessId String
  sku        String?
  name       String
  category   String?
  unit       StockUnit @default(PIECE)

  minQty    Int @default(0)
 maxQty    Int @default(0)              
  onHandQty Int @default(0)

  lastPriceCents Int     @default(0)
  supplierName   String?

notes     String?                      

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business  Business            @relation(fields: [businessId], references: [id])
  movements InventoryMovement[]
  reqItems  RequisitionItem[]

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  @@index([businessId, isActive])
  @@index([businessId, name])
}

model InventoryMovement {
  id          String       @id @default(cuid())
  businessId  String
  itemId      String
  type        MovementType
  qty         Int
  note        String?
  destinationBusinessId String?
  createdById String
  createdAt   DateTime     @default(now())

business             Business  @relation("InventoryMovementOrigin", fields: [businessId], references: [id])
destinationBusiness  Business? @relation("InventoryMovementDestination", fields: [destinationBusinessId], references: [id])
  item      InventoryItem @relation(fields: [itemId], references: [id])
  createdBy User          @relation("InventoryMoveCreatedBy", fields: [createdById], references: [id])

  @@index([businessId, createdAt])
  @@index([itemId, createdAt])
  @@index([destinationBusinessId])
}

model Requisition {
  id         String            @id @default(cuid())
  businessId String
  status     RequisitionStatus @default(DRAFT)
  title      String
  note       String?
  neededBy   DateTime?

  createdById  String
  approvedById String?

  // Tipo de requisicion y configuracion
  kind                    RequisitionKind     @default(RESTAURANT)
  eventName               String?
  eventId                 String?
  event                   Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  isPrivate               Boolean             @default(false)
  priority                RequisitionPriority @default(NORMAL)
  urgentNote              String?
  requiresSeparatePayment Boolean             @default(false)

  // Estados de entrega
  deliveredAt    DateTime?
  deliveredById  String?
  deliveredBy    User?     @relation("RequisitionDeliveredBy", fields: [deliveredById], references: [id])
  deliveryNote   String?

  receivedAt        DateTime?
  receivedById      String?
  receivedBy        User?     @relation("RequisitionReceivedBy", fields: [receivedById], references: [id])
  receivedSignature String?

  // Relacion con cuenta por pagar
  accountsPayable AccountsPayable?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id])
  createdBy  User     @relation("ReqCreatedBy", fields: [createdById], references: [id])
  approvedBy User?    @relation("ReqApprovedBy", fields: [approvedById], references: [id])

  items RequisitionItem[]

  @@index([businessId, status, createdAt])
  @@index([kind])
  @@index([eventId])
  @@index([priority])
  @@index([isPrivate])
}

model Event {
  id                 String      @id @default(cuid())
  businessId         String
  locationBusinessId String?

  title              String
  eventType          String?
  status             EventStatus @default(DRAFT)
  startsAt           DateTime
  endsAt             DateTime?

  estimatedGuests    Int @default(0)
  confirmedGuests    Int @default(0)

  locationName       String?
  locationAddress    String?

  contactName        String?
  contactPhone       String?
  contactEmail       String?

  description        String?
  internalNotes      String?
  isPrivate          Boolean @default(false)

  paymentTiming      EventPaymentTiming @default(NOT_DEFINED)
  paymentStatus      EventPaymentStatus @default(PENDING)
  quotedAmountCents  Int @default(0)
  paidAmountCents    Int @default(0)
  paymentDueAt       DateTime?
  paymentNotes       String?

  createdById        String
  responsibleUserId  String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business           Business  @relation("EventBusiness", fields: [businessId], references: [id])
  locationBusiness   Business? @relation("EventLocationBusiness", fields: [locationBusinessId], references: [id])
  createdBy          User      @relation("EventCreatedBy", fields: [createdById], references: [id])
  responsibleUser    User?     @relation("EventResponsible", fields: [responsibleUserId], references: [id])

  requirements       EventRequirement[]
  requisitions       Requisition[]

  @@index([businessId, startsAt])
  @@index([locationBusinessId, startsAt])
  @@index([status, startsAt])
  @@index([responsibleUserId, startsAt])
  @@index([paymentStatus, paymentDueAt])
  @@index([isPrivate])
}

model EventRequirement {
  id                String                 @id @default(cuid())
  eventId           String
  category          String?
  description       String
  quantity          Float?
  unit              String?
  status            EventRequirementStatus @default(PENDING)
  responsibleUserId String?
  neededBy          DateTime?
  notes             String?
  sortOrder         Int @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event             Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responsibleUser   User? @relation("EventRequirementResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([responsibleUserId, status])
  @@index([neededBy])
}

model RequisitionItem {
  id            String  @id @default(cuid())
  requisitionId String
  itemId        String?

  qtyRequested Int
  qtyApproved  Int?
  qtyReceived  Int?

  freeTextName       String?
  freeTextUnit       String?
  qtyDelivered       Int?
  notDeliveredReason String?
  deliveredAt        DateTime?

  estimatedPriceCents Int @default(0)

  note      String?
  createdAt DateTime @default(now())

  requisition Requisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item        InventoryItem? @relation(fields: [itemId], references: [id])

  @@index([requisitionId])
  @@index([itemId])
}

enum CatalogType {
  EXPENSE_CATEGORY
  SALE_CONCEPT
  TASK_AREA_TAG
  INVENTORY_CATEGORY
  GENERIC
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model CatalogItem {
  id        String      @id @default(cuid())
  type      CatalogType
  name      String
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([type, name])
  @@index([type, isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  // nullable para LOGIN_FAILED de usuarios inexistentes
  userName   String
  userRole   String?
  businessId String?
  action     String   // SALE_CREATED, ITEM_CANCELED, PRICE_EDITED, etc.
  entity     String   // Sale, MenuItem, InventoryItem, etc.
  entityId   String?
  severity   String   @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  summary    String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
  @@index([entity, entityId])
}


enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  DIRTY
  OUT_OF_SERVICE
  MAINTENANCE
  BLOCKED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELED
  NO_SHOW
}

enum RoomTypeKind {
  STANDARD
  SUITE
  GLAMPING
  CONTAINER
}

model HotelRoomType {
  id         String @id @default(cuid())
  businessId String

  name           String
  description    String?
  basePriceCents Int
  capacity       Int
  kind           RoomTypeKind @default(STANDARD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business    @relation(fields: [businessId], references: [id])
  rooms    HotelRoom[]

  @@unique([businessId, name])
  @@index([businessId])
}

model HotelRoom {
  id         String @id @default(cuid())
  businessId String
  roomTypeId String

  name     String
  floor    String?
  status   RoomStatus @default(AVAILABLE)
  isActive Boolean    @default(true)

  area      String?
