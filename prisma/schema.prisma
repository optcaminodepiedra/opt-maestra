  isUrgent      Boolean               @default(false)
  note          String?

  createdById   String
  paidAt        DateTime?
  paidById      String?
  paymentMethod String?
  paymentRef    String?

  linkedExpenseId    String?
  linkedExpense      Expense?    @relation("APExpense", fields: [linkedExpenseId], references: [id])

  linkedWithdrawalId String?
  linkedWithdrawal   Withdrawal? @relation("APWithdrawal", fields: [linkedWithdrawalId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business?    @relation(fields: [businessId], references: [id])
  requisition Requisition? @relation(fields: [requisitionId], references: [id])
  createdBy   User         @relation("AccountsPayableCreatedBy", fields: [createdById], references: [id])
  paidBy      User?        @relation("AccountsPayablePaidBy", fields: [paidById], references: [id])

