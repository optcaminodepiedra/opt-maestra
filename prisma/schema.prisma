  showBorder Boolean @default(true)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation("BusinessRestaurantAreas", fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId])
}

model Printer {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation("BusinessPrinters", fields: [businessId], references: [id], onDelete: Cascade)

  name       String
  role       PrinterRole @default(CASHIER)
  ipAddress  String
  port       Int         @default(9100)
  paperWidth Int         @default(48)  // caracteres (48 = 80mm térmico estándar)
  isActive   Boolean     @default(true)
  lastSeenAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  printJobs PrintJob[]

  @@index([businessId, isActive])
  @@index([businessId, role])
