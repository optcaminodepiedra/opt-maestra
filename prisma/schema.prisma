model SalePayment {
  id                 String   @id @default(cuid())
  saleId             String
  businessId         String
  externalPaymentType String? // "EF", "VISA", "MASTER", etc.
  method             String?  // "CASH", "CARD", "TRANSFER" normalizado
  amountCents        Int      @default(0)
  tipCents           Int      @default(0)
  reference          String?
  exchangeRate       Float    @default(1.0)
  importBatchId      String?
