  menuItemId      String
  modifierGroupId String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  menuItem        MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup   MenuModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([menuItemId])
}

model SaleLine {
  id          String   @id @default(cuid())
  saleId      String
  businessId  String

  menuItemId  String?

  // snapshot de datos del producto al momento de la venta
  productCode String?
  productName String
  groupCode   String?
  groupName   String?

  // cantidades y montos (en centavos para ints)
  qty             Float @default(1)
  unitPriceCents  Int   @default(0)
  discountCents   Int   @default(0)
  taxPercent      Float @default(0)
  amountCents     Int   @default(0)  // qty * (unit - discount) por item

  // datos extra de SoftRestaurant
  movimiento           Int?
  comanda              String?
  comentario           String?
  estacion             String?
  isModifier           Boolean @default(false)
  isCompoundChild      Boolean @default(false)
  isCompoundPrincipal  Boolean @default(false)
  modifiers            Json?
  soldAt               DateTime?
  externalWaiterId     String?

  // trazabilidad de import
  importBatchId      String?
  externalSource     String?  // "softrestaurant"
  externalFolioDet   String?  // cheqdet.foliodet
  externalMovimiento Int?

  createdAt DateTime @default(now())

  sale        Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  business    Business      @relation(fields: [businessId], references: [id])
  menuItem    MenuItem?     @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  importBatch ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([businessId])
  @@index([menuItemId])
  @@index([productCode])
  @@index([groupCode])
  @@index([importBatchId])
  @@index([externalSource, externalFolioDet])
}

model ExternalUserMapping {
  id               String   @id @default(cuid())
  businessId       String
  externalSource   String   // "softrestaurant"
  externalUserId   String   // ej "12"
  externalUserName String?  // ej "ANDRES"
  userId           String?  // null hasta que se mapee a un User real
  kind             String   @default("WAITER") // WAITER, CASHIER, COOK, etc.
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([businessId, externalSource, externalUserId, kind])
  @@index([businessId])
  @@index([userId])
}

model SoftRestaurantShift {
  id              String   @id @default(cuid())
  businessId      String
  externalSource  String   @default("softrestaurant")
  externalShiftId String
  openedAt        DateTime?
  closedAt        DateTime?
  cashierName     String?
  station         String?
  fondoCents      Int      @default(0)
  cashCents       Int      @default(0)
  cardCents       Int      @default(0)
  valesCents      Int      @default(0)
  creditCents     Int      @default(0)
